# Copy this file to .env and fill in your key. Never commit .env.

# Provider selection: gemini (Developer API) or gemini_enterprise (Vertex AI)
LLM_PROVIDER=gemini

# API key used to authenticate Gemini Developer API requests.
GOOGLE_API_KEY= 

# Google Cloud project used for Vertex AI when the Enterprise provider is selected.
GOOGLE_CLOUD_PROJECT= 

# Vertex AI region used for Enterprise model discovery and requests.
# Use global for Search Grounding on Gemini 3.x; embeddings for sub-phase 2b2 must also be verified at this location.
GOOGLE_CLOUD_LOCATION=global

# Path to the local service-account credential file used by Application Default Credentials.
GOOGLE_APPLICATION_CREDENTIALS=

# Supabase Postgres connection string used for document storage and ingestion.
DATABASE_URL=
# Shared secret authenticating inbound requests from the AkadVerse backend.
AI_SERVICE_API_KEY=
# Shared secret authenticating outbound ingestion callbacks to the AkadVerse backend.
AI_SERVICE_CALLBACK_SECRET=
